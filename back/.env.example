## Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_server_only

## Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

## Auth / JWT
JWT_SECRET=change_me_long_random_string
PASSWORD_RESET_TTL_MINUTES=30

GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

## Stripe
STRIPE_SECRET_KEY=sk_test_or_sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

## Pickup / return handover codes
PICKUP_CODE_PEPPER=change_me_random_pepper

## Email / SMTP
EMAIL_FROM="Rentify <rentify@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rentify@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_PASSWORD=your_smtp_password_or_app_password

## Dev helper (set once when your LAN IP changes)
DEV_HOST=10.0.0.10
DEV_EXPO_PORT=8081

## AI Concierge
ASSISTANT_PROVIDER=gemini
ASSISTANT_KNOWLEDGE_TABLE=assistant_knowledge_documents
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
ASSISTANT_ENABLE_DB_LOGGING=true
ASSISTANT_ENABLE_TOOL_LOGGING=true
ASSISTANT_MAX_CONTEXT_MESSAGES=12
ASSISTANT_MAX_TOOL_ROUNDS=3
KNOWLEDGE_EMBED_BATCH_SIZE=24
KNOWLEDGE_VEHICLE_LIMIT=500

## Reservations (true/false)
RESERVATION_STATUS_TEST_MODE=true
